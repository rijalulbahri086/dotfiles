{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["wlr/taskbar"],
  "modules-right": ["custom/minimized", "cpu", "memory", "network", "bluetooth", "battery", "clock"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },

  "cpu": { "interval": 2, "format": "CPU {usage}%", "on-click": "kitty -e btop" },

  "memory": {
    "interval": 2,
    "format": "RAM {}%",
    "format-alt": "RAM {used:0.1f}/{total:0.1f} GiB",
    "on-click-right": "kitty -e btop",
    "tooltip": true
  },

  "temperature": { "format": "{temperatureC}°C", "critical-threshold": 80 },
  "pulseaudio": { "format": "VOL {volume}%", "format-muted": "MUTE" },


  "network": {
  "format-wifi": "{essid}",
  "format-ethernet": "ETH",
  "format-disconnected": "WiFi mati",
  "on-click": "kitty -e nmtui"
  },

  "battery": { "format": "BAT {capacity}%", "states": { "warning": 30, "critical": 15 } },

  "custom/minimized": {
    "exec": "~/.local/bin/minimized-list",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.local/bin/minimized-restore",
    "format": "{}",
    "tooltip": true
  },

  "clock": { "format": "{:%H:%M | %a, %d %b}", "interval": 60 }
}
