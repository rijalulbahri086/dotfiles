-- Generated by hyprlang2lua. Review TODOs before reloading Hyprland.

-- Source: ~/.cache/wal/colors-hyprland.conf — convert this file to Lua and ensure it is on Lua's package.path.
dofile(os.getenv("HOME") .. "/.cache/wal/colors-hyprland.lua")
local terminal = "kitty"
local menu = "wofi --show drun"
local mainMod = "SUPER"

hl.env("AQ_DRM_DEVICES", "/dev/dri/intel-igpu")

hl.monitor({
    output = "",
    mode = "preferred",
    position = "auto",
    scale = "1",
})

hl.curve("smooth", { type = "bezier", points = { { 0.20, 0.80 }, { 0.20, 1.0 } } })
hl.animation({
    leaf = "windows",
    enabled = true,
    speed = 4,
    bezier = "smooth",
})
hl.animation({
    leaf = "windowsIn",
    enabled = true,
    speed = 4,
    bezier = "smooth",
    style = "popin 85%",
})
hl.animation({
    leaf = "windowsOut",
    enabled = true,
    speed = 3,
    bezier = "smooth",
    style = "popin 85%",
})
hl.animation({
    leaf = "fade",
    enabled = true,
    speed = 3,
    bezier = "smooth",
})
hl.animation({
    leaf = "workspaces",
    enabled = true,
    speed = 4,
    bezier = "smooth",
})

hl.bind(mainMod .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + SPACE", hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd("thunar"))
hl.bind(mainMod .. " + H", hl.dsp.exec_cmd("~/.local/bin/hypr-shortcuts"))
hl.bind(mainMod .. " + ESCAPE", hl.dsp.exec_cmd("kitty -e btop"))
hl.bind(mainMod .. " + W", hl.dsp.exec_cmd("kitty -e nmtui"))
hl.bind(mainMod .. " + SHIFT + ESCAPE", hl.dsp.exec_cmd("~/.local/bin/killmenu"))
hl.bind(mainMod .. " + B", hl.dsp.exec_cmd("kitty -e bluetui"))
hl.bind(mainMod .. " + SHIFT + W", hl.dsp.exec_cmd("~/.local/bin/wallpaper"))
hl.bind("Print", hl.dsp.exec_cmd("~/.local/bin/screenshot area-copy"))
hl.bind("SHIFT + Print", hl.dsp.exec_cmd("~/.local/bin/screenshot area-save"))
hl.bind("CTRL + Print", hl.dsp.exec_cmd("~/.local/bin/screenshot full-save"))
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.exec_cmd("~/.local/bin/screenshot area-copy"))
hl.bind(mainMod .. " + P", hl.dsp.exec_cmd("~/.local/bin/powermenu"))

hl.bind(mainMod .. " + Q", hl.dsp.window.close())
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" }))
hl.bind(mainMod .. " + M", hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" }))
hl.bind(mainMod .. " + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + SHIFT + M", hl.dsp.exit())

hl.bind("ALT + TAB", hl.dsp.window.cycle_next({ next = true }))
hl.bind("ALT + SHIFT + TAB", hl.dsp.window.cycle_next({ prev = true }))

hl.bind(mainMod .. " + LEFT", hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + RIGHT", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + UP", hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + DOWN", hl.dsp.focus({ direction = "down" }))

hl.bind(mainMod .. " + SHIFT + LEFT", hl.dsp.window.move({ direction = "l" }))
hl.bind(mainMod .. " + SHIFT + RIGHT", hl.dsp.window.move({ direction = "r" }))
hl.bind(mainMod .. " + SHIFT + UP", hl.dsp.window.move({ direction = "u" }))
hl.bind(mainMod .. " + SHIFT + DOWN", hl.dsp.window.move({ direction = "d" }))

hl.bind("SUPER + N", hl.dsp.exec_cmd("~/.local/bin/hypr-minimize"))
hl.bind("SUPER + SHIFT + N", hl.dsp.exec_cmd("~/.local/bin/hypr-restore"))

hl.bind(mainMod .. " + 1", hl.dsp.focus({ workspace = 1 }))
hl.bind(mainMod .. " + 2", hl.dsp.focus({ workspace = 2 }))
hl.bind(mainMod .. " + 3", hl.dsp.focus({ workspace = 3 }))
hl.bind(mainMod .. " + 4", hl.dsp.focus({ workspace = 4 }))
hl.bind(mainMod .. " + 5", hl.dsp.focus({ workspace = 5 }))
hl.bind(mainMod .. " + SHIFT + 1", hl.dsp.window.move({ workspace = 1 }))
hl.bind(mainMod .. " + SHIFT + 2", hl.dsp.window.move({ workspace = 2 }))
hl.bind(mainMod .. " + SHIFT + 3", hl.dsp.window.move({ workspace = 3 }))
hl.bind(mainMod .. " + SHIFT + 4", hl.dsp.window.move({ workspace = 4 }))
hl.bind(mainMod .. " + SHIFT + 5", hl.dsp.window.move({ workspace = 5 }))
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up", hl.dsp.focus({ workspace = "e-1" }))

hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag())
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize())

hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("swayosd-client --output-volume raise"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("swayosd-client --output-volume lower"), { locked = true, repeating = true })
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("swayosd-client --output-volume mute-toggle"), { locked = true })
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("swayosd-client --brightness raise"), { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("swayosd-client --brightness lower"), { locked = true, repeating = true })

hl.gesture({
    fingers = 3,
    direction = "horizontal",
    action = "workspace",
})
hl.gesture({ fingers = 3, direction = "down", mods = "ALT", action = "close" })
hl.config({
    input = {
        kb_layout = "us",
    },
    general = {
        gaps_in = 5,
        gaps_out = 10,
        border_size = 2,
        col = {
            active_border = color4,
            inactive_border = color8,
        },
        resize_on_border = true,
    },
    animations = {
        enabled = true,
    },
    decoration = {
        rounding = 10,
        active_opacity = 1.0,
        inactive_opacity = 0.95,
        shadow = {
            enabled = false,
        },
        blur = {
            enabled = false,
        },
    },
    misc = {
        disable_hyprland_logo = true,
        force_default_wallpaper = 0,
    },
    -- --- Aplikasi ---
    -- --- Jendela ---
    -- --- Pindah antar aplikasi ---
    -- --- Minimize / restore (script milikmu) ---
    -- --- Workspace 1-5 ---
    -- --- Mouse: geser & resize jendela ---
    -- --- OSD volume & brightness ---
    -- Gestur touchpad
})

hl.on("hyprland.start", function()
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd("swayosd-server")
    hl.exec_cmd("hyprpaper")
    hl.exec_cmd("~/.local/bin/waybar-run")
end)


hl.config({ binds = { hide_special_on_workspace_change = true } })

for _, p in ipairs({
    { "claude",  "^brave-claude\\.ai" },
    { "chatgpt", "^brave-chatgpt\\.com" },
    { "gemini",  "^brave-gemini\\.google\\.com" },
    { "ollama",  "^ai-ollama$" },
}) do
    hl.window_rule({
        name = "ai-" .. p[1],
        match = { class = p[2] },
        float = true,
        size = "900 600",
        move = { "(monitor_w-window_w)/2", "60" },
        workspace = "special:ai-" .. p[1],
    })
end
hl.bind(mainMod .. " + A", hl.dsp.exec_cmd("~/.local/bin/aichat"))

hl.config({ general = { extend_border_grab_area = 20 } })
